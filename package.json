{
  "name": "gogroup-cro-matrix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Matriz de testes A/B, ganho acumulado e roadmap de CRO das marcas Gobeaute e GoJump",
  "scripts": {
    "fetch:elevate": "node scripts/fetch-elevate.mjs",
    "fetch:jira": "node scripts/fetch-jira.mjs",
    "fetch": "npm run fetch:elevate && npm run fetch:jira",
    "build": "node scripts/build.mjs",
    "refresh": "npm run fetch && npm run build",
    "serve": "npm run build && node -e \"const{createServer}=require('http'),fs=require('fs');createServer((q,s)=>{s.setHeader('content-type','text/html;charset=utf-8');s.end(fs.readFileSync('dist/index.html'))}).listen(4173,()=>console.log('http://localhost:4173'))\""
  },
  "engines": { "node": ">=20" }
}
