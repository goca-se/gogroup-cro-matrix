ELEVATE_KOKESHI=elv_...
ELEVATE_RITUARIA=elv_...
ELEVATE_LESCENT=elv_...
ELEVATE_DENAVITA=elv_...

# GoJump — uma instância do Elevate por região.
ELEVATE_WAK_US=elv_...
ELEVATE_POTTD_EU=elv_...
ELEVATE_POTTD_UK=elv_...
ELEVATE_POTTD_AU=elv_...
