# Um token por loja no Elevate. Só as lojas com token são consultadas.
ELEVATE_APICE=elv_...
ELEVATE_BARBOURS=elv_...
ELEVATE_KOKESHI=elv_...
ELEVATE_RITUARIA=elv_...
ELEVATE_LESCENT=elv_...

# Lojas do GoJump — ainda não existem no Elevate. Descomente em scripts/config.mjs
# ao mesmo tempo em que preencher aqui.
# ELEVATE_POTTD=elv_...
# ELEVATE_WAK=elv_...

# Jira, só para o roadmap. Token em id.atlassian.com/manage-profile/security/api-tokens
JIRA_HOST=goengenharia.atlassian.net
JIRA_EMAIL=voce@gocase.com
JIRA_API_TOKEN=ATATT...

# Probabilidade mínima (em RPV) para declarar vencedor. Padrão 95.
# SIGNIFICANCE=95
